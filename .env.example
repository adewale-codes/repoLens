# RepoLens API environment. Locally, copy this to .env. On Railway, set these
# in the service's Variables tab (Railway doesn't read .env files).

# --- Required in production -------------------------------------------------

# Claude API key; POST /ask needs it (ingestion doesn't).
ANTHROPIC_API_KEY=

# Where all persistent data lives: the SQLite index (chunks, embeddings, import
# graphs, ingest jobs), repo clones, and the downloaded embedding model.
# Default: ./data (relative to the working directory), fine for local dev.
# The Docker image sets /data. On Railway, attach a Volume mounted at /data,
# or every redeploy wipes every indexed repo. GET /health reports
# "storage": {"persistent": true} once the volume is in place.
REPOLENS_DATA_DIR=/data

# --- Optional (defaults shown; see config.py) --------------------------------

# REPOLENS_CLAUDE_MODEL=claude-opus-5
# REPOLENS_CLAUDE_EFFORT=high
# REPOLENS_EMBED_MODEL=jinaai/jina-embeddings-v2-base-code   # changing it requires re-ingesting every repo
# REPOLENS_EMBED_MAX_CHARS=2000
# REPOLENS_MAX_FILE_BYTES=400000
# REPOLENS_TOP_K=8
# REPOLENS_GRAPH_EXPAND_SEEDS=3
# REPOLENS_GRAPH_EXPAND_MAX=4
# REPOLENS_CONTEXT_CHAR_BUDGET=60000

# Set automatically by Railway; don't define them yourself:
# PORT, RAILWAY_SERVICE_ID, RAILWAY_VOLUME_MOUNT_PATH
